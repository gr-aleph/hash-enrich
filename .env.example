# Copy this file to .env and put your own values there.
# .env is in .gitignore. Never commit it, and never put a real key in this file.

BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
VT_API_KEY=your-virustotal-key-here
# Used from Milestone 2 (MalwareBazaar and ThreatFox)
ABUSECH_AUTH_KEY=your-abusech-key-here
SOURCE_TIMEOUT_SECONDS=10
